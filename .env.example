# Plantilla de variables de entorno. El .env real NO se versiona.
#
# IMPORTANTE: ningún valor puede quedar VACÍO. decouple resuelve cada variable como
# `valor_del_archivo or os.environ[VARIABLE]`, así que un valor vacío cae a la variable
# de entorno y, si tampoco existe, revienta con KeyError al arrancar. Usa un valor de
# relleno (p. ej. `local`) antes que dejar la clave en blanco.
#
# Dónde va el archivo:
#   .env       -> raíz del repo, lo lee docker compose para interpolar ${VARIABLES}
#   luka/.env  -> lo lee el Django que corre en tu máquina (decouple lo busca ahí primero)
# Ver docs/desarrollo-local.md

SECRET_KEY=cambiar-esta-clave
DEBUG=True
MEDIA_URL=/media/

# En el host la base es localhost (docker compose la publica en 127.0.0.1:5432).
# Dentro de los contenedores es db-luka, y eso lo fija el propio compose.
DATABASE_URL=postgres://luka:luka@localhost:5432/luka

# Con las que docker compose crea el rol y la base del contenedor de postgres
POSTGRES_DB=luka
POSTGRES_USER=luka
POSTGRES_PASSWORD=luka

# Conexión AWS S3. En local sirven valores de relleno, pero no pueden ir vacíos.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
BUCKET=local
REGION_NAME=us-east-1
