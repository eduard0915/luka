# Copiar a .env y ajustar. El .env NO se versiona.
# Estas son las variables que luka/settings.py lee con config() sin default.

POSTGRES_DB=luka
POSTGRES_USER=luka
POSTGRES_PASSWORD=luka

# El host 'db-luka' es el nombre del servicio de postgres en docker-compose.yml
DATABASE_URL=postgres://luka:luka@db-luka:5432/luka

SECRET_KEY=cambiar-esta-clave
DEBUG=True
MEDIA_URL=/media/

# Conexión AWS S3 (en local pueden ir valores de relleno)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUCKET=
REGION_NAME=us-east-1
